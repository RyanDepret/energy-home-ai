# URL de ton API FastAPI (sans slash final)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL publique du site (SEO, sitemap, image de partage). Obligatoire en production Vercel : le build échoue si absente ou localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Facultatif : URL qui reçoit les messages du formulaire de contact (webhook, n8n, Make…)
CONTACT_WEBHOOK_URL=
# Facultatif : code de vérification Google Search Console (balise HTML, valeur de content uniquement)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
